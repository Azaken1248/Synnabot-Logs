# ==============================================================================
# Synnabot Log Broadcaster - Environment Configuration Example
# ==============================================================================

# Application Environment (production, development, test)
NODE_ENV=development

# Server Port
PORT=6565

# PM2 Application Name to Monitor
PM2_APP_NAME=Synnabot

# Log Level for Server (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# CORS Origin (comma-separated list for multiple origins, or * for wildcard)
CORS_ORIGIN=*

# Rate Limiting (applied to non-SSE endpoints)
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100

# PM2 Integration Tuning
LOG_BUFFER_FLUSH_MS=1000
SSE_HEARTBEAT_MS=15000
PM2_RECONNECT_DELAY_MS=5000
